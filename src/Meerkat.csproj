<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Rhino 8 on .NET 8 (its default runtime on Windows); Rhino in NETFramework mode does not load this build. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Meerkat</AssemblyName>
    <TargetExt>.gha</TargetExt>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
    <!-- bin keeps one .gha: no deps.json, symbols or satellite folders next to it. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <RhinoDir Condition="'$(RhinoDir)' == ''">C:\Program Files\Rhino 8</RhinoDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Assets\Icons\png\*.png"><LogicalName>Meerkat.Icons.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Assets\Brand\icon-24.png"><LogicalName>Meerkat.Icons.Meerkat.png</LogicalName></EmbeddedResource>
    <!-- The .NET builds of the local Rhino 8: RhinoCommon and Newtonsoft.Json from System\netcore, Grasshopper as installed. -->
    <Reference Include="RhinoCommon"><HintPath>$(RhinoDir)\System\netcore\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(RhinoDir)\System\netcore\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Grasshopper"><HintPath>$(RhinoDir)\Plug-ins\Grasshopper\Grasshopper.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GH_IO"><HintPath>$(RhinoDir)\Plug-ins\Grasshopper\GH_IO.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="MeerkatCheckRhino" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('%(Reference.HintPath)') and '%(Reference.HintPath)' != ''" Text="Riferimento Rhino mancante: %(Reference.HintPath). Indicare RhinoDir (Build.ps1 -RhinoDir)." />
  </Target>
</Project>
