                    <item name="Description" type_name="gh_string" type_code="10">A panel for custom notes and text values</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">65a6322d-4c6c-49ad-9b2e-408893f54d13</item>
                    <item name="Name" type_name="gh_string" type_code="10">Panel</item>
                    <item name="NickName" type_name="gh_string" type_code="10">05 | ORIGINE LOCALE, EXPORT 3DM E ARCHIVIO</item>
